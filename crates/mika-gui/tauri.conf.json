{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mika",
  "version": "0.4.3",
  "identifier": "dev.mika.assistant",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build"
  },
  "app": {
    "windows": [
      {
        "label": "island",
        "title": "Мика",
        "width": 1000,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Mika",
    "category": "Productivity",
    "shortDescription": "Мика — ИИ-помощник для Windows",
    "longDescription": "Живой ИИ-помощник для Windows: чат в островке вверху экрана, действия в системе с проверкой риска, любой LLM-провайдер.",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}